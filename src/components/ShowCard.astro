---
export interface Props {
  date: string;
  venue: string;
  city: string;
  state?: string;
  ticketLink?: string;
  isPast?: boolean;
}

const { date, venue, city, state, ticketLink, isPast = false } = Astro.props;

// Format date for display
const dateObj = new Date(date + 'T00:00:00');
const formattedDate = dateObj.toLocaleDateString('en-AU', {
  weekday: 'short',
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article class={`bg-white rounded-lg shadow-md p-6 transition-transform hover:scale-105 ${isPast ? 'opacity-75' : ''}`}>
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div class="flex-grow">
      <!-- Date -->
      <time 
        datetime={date}
        class="text-accent font-bold text-lg block mb-2"
      >
        {formattedDate}
      </time>

      <!-- Venue & Location -->
      <h3 class="font-display text-xl font-bold text-neutral-900 mb-1">
        {venue}
      </h3>
      <p class="text-neutral-600">
        {city}{state && `, ${state}`}
      </p>
    </div>

    <!-- Ticket Link -->
    {ticketLink && !isPast && (
      <div class="md:flex-shrink-0">
        <a 
          href={ticketLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-block text-center w-full md:w-auto"
        >
          Get Tickets
        </a>
      </div>
    )}
  </div>
</article>

