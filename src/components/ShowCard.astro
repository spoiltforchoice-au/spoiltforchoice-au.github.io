---
export interface Props {
  date: string;
  venue: string;
  city: string;
  state?: string;
  time?: string;
  ticketLink?: string;
  mapsLink?: string;
  isPast?: boolean;
}

const { date, venue, city, state, time, ticketLink, mapsLink, isPast = false } = Astro.props;

// Format date for display
const dateObj = new Date(date + 'T00:00:00');
const formattedDate = dateObj.toLocaleDateString('en-AU', {
  weekday: 'short',
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article class={`bg-white rounded-lg shadow-md p-6 transition-transform hover:scale-105 ${isPast ? 'opacity-75' : ''}`}>
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div class="flex-grow">
      <!-- Date -->
      <time 
        datetime={date}
        class="text-accent font-bold text-lg block mb-2"
      >
        {formattedDate}
      </time>

      <!-- Venue & Location -->
      <h3 class="font-display text-xl font-bold text-neutral-900 mb-1">
        {venue}
      </h3>
      <div class="flex items-center flex-wrap gap-x-2 text-neutral-600 mb-2">
        {mapsLink ? (
          <a 
            href={mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent transition-colors inline-flex items-center gap-1"
          >
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>{city}{state && `, ${state}`}</span>
          </a>
        ) : (
          <span>{city}{state && `, ${state}`}</span>
        )}
        {time && (
          <>
            <span class="text-neutral-500">•</span>
            <span class="text-neutral-500">{time}</span>
          </>
        )}
      </div>
    </div>

    <!-- Ticket Link or Free Entry -->
    {!isPast && (
      <div class="md:flex-shrink-0">
        {ticketLink && ticketLink !== "TBA" ? (
          <a 
            href={ticketLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-6 py-3 rounded-lg font-semibold bg-blue-100 text-blue-800 hover:bg-blue-200 transition-colors text-center w-full md:w-auto"
          >
            Get Tickets
          </a>
        ) : ticketLink === "TBA" ? (
          <span class="inline-block px-6 py-3 rounded-lg font-semibold bg-amber-100 text-amber-800 text-center w-full md:w-auto">
            Tickets TBA
          </span>
        ) : (
          <span class="inline-block px-6 py-3 rounded-lg font-semibold bg-green-100 text-green-800 text-center w-full md:w-auto">
            Free Entry
          </span>
        )}
      </div>
    )}
  </div>
</article>

