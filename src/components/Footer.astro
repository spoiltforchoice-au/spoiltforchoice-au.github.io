---
import SocialLinks from './SocialLinks.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-white mt-auto">
  <div class="container-custom py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <h3 class="font-display text-xl font-bold mb-4">Spoilt For Choice</h3>
        <p class="text-neutral-400 text-sm">
          Canberra-based cover band playing everything from 80s and 90s rock to blues and modern hits.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-display text-lg font-bold mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li>
            <a href="/" class="text-neutral-400 hover:text-white transition-colors text-sm">
              Home
            </a>
          </li>
          <li>
            <a href="/upcoming-performance" class="text-neutral-400 hover:text-white transition-colors text-sm">
              Upcoming Performance
            </a>
          </li>
          <li>
            <a href="/about-us" class="text-neutral-400 hover:text-white transition-colors text-sm">
              About Us
            </a>
          </li>
          <li>
            <a href="/contact-us" class="text-neutral-400 hover:text-white transition-colors text-sm">
              Contact Us
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact & Social -->
      <div>
        <h3 class="font-display text-lg font-bold mb-4">Connect</h3>
        <div class="space-y-4">
          <div>
            <p class="text-neutral-400 text-sm mb-2">Email us:</p>
            <a 
              href="mailto:spoiltforchoice.au@gmail.com" 
              class="text-white hover:text-accent transition-colors text-sm"
            >
              spoiltforchoice.au@gmail.com
            </a>
          </div>
          <div>
            <p class="text-neutral-400 text-sm mb-3">Follow us:</p>
            <div class="[&_a]:text-neutral-300 [&_a:hover]:text-accent">
              <SocialLinks />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-neutral-700 mt-8 pt-8 text-center">
      <p class="text-neutral-400 text-sm">
        © {currentYear} Spoilt For Choice. All rights reserved.
      </p>
    </div>
  </div>
</footer>

