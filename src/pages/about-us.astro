---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="About Us - Spoilt For Choice" 
  description="Learn about Spoilt For Choice, a Canberra-based Australian cover band bringing high-energy performances to venues across the country."
>
  <Header slot="header" />
  
  <!-- Page Header -->
  <section class="section-padding bg-neutral-900 text-white">
    <div class="container-custom text-center">
      <h1 class="mb-4">About Us</h1>
      <p class="text-xl max-w-2xl mx-auto">
        Canberra's energetic cover band bringing your favourite hits to life.
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto space-y-8">
        <!-- Band Story -->
        <div>
          <h2 class="text-3xl font-bold mb-6">Our Story</h2>
          <div class="prose prose-lg max-w-none">
            <p class="text-lg text-neutral-700 leading-relaxed mb-4">
              Spoilt For Choice is a Canberra-based cover band that's been bringing crowd favourites to life across the region. 
              We specialise in delivering high-energy performances that get people on their feet, playing the hits everyone knows and loves.
            </p>
            <p class="text-lg text-neutral-700 leading-relaxed mb-4">
              From classic rock anthems to modern chart-toppers, we've got a repertoire that keeps the party going all night long. 
              Whether we're playing intimate pubs or larger venues, we bring the same enthusiasm and energy to every gig.
            </p>
            <p class="text-lg text-neutral-700 leading-relaxed">
              Based in Canberra, we're your go-to band for functions, pub gigs, and events where great music and good vibes are essential. 
              We pride ourselves on reading the crowd and delivering exactly what they want to hear.
            </p>
          </div>
        </div>

        <!-- Band Photo -->
        <div class="rounded-lg overflow-hidden shadow-xl">
          <img 
            src="/images/band-photo-2.jpg" 
            alt="Spoilt For Choice band performing live on stage"
            class="w-full h-auto"
            loading="eager"
          />
        </div>

        <!-- Call to Action -->
        <div class="text-center pt-8">
          <h3 class="text-2xl font-bold mb-4">See Us Live</h3>
          <p class="text-lg text-neutral-700 mb-6">
            Check out our upcoming shows and experience the energy for yourself.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/upcoming-performance" class="btn-primary">
              View Shows
            </a>
            <a href="/contact-us" class="btn-secondary">
              Get In Touch
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

