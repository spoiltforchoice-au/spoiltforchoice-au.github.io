---
import MinimalLayout from '../layouts/MinimalLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<MinimalLayout 
  title="Spoilt For Choice - Australian Rock Band" 
  description="Spoilt For Choice is an Australian band bringing raw energy and authentic sound to stages across the country."
>
  <div class="min-h-screen flex flex-col items-center justify-center px-4 py-12">
    <!-- Band Name Title -->
    <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold text-center mb-8 text-neutral-900">
      Spoilt For Choice
    </h1>

    <!-- Social Media Links -->
    <div class="mb-12">
      <SocialLinks />
    </div>

    <!-- Navigation Links -->
    <nav aria-label="Main navigation" class="mb-16">
      <ul class="flex flex-col sm:flex-row gap-6 items-center justify-center">
        <li>
          <a 
            href="/upcoming-performance" 
            class="btn-primary text-lg px-8 py-4"
          >
            Upcoming Performance
          </a>
        </li>
        <li>
          <a 
            href="/about-us" 
            class="btn-primary text-lg px-8 py-4"
          >
            About Us
          </a>
        </li>
        <li>
          <a 
            href="/contact-us" 
            class="btn-primary text-lg px-8 py-4"
          >
            Contact Us
          </a>
        </li>
      </ul>
    </nav>

    <!-- Band Photos -->
    <div class="max-w-6xl w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="aspect-square overflow-hidden rounded-lg shadow-lg">
          <img 
            src="/images/sfc_band_square.jpg" 
            alt="Spoilt For Choice band photo"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-lg shadow-lg">
          <img 
            src="/images/sfc_band_long.jpg" 
            alt="Spoilt For Choice performing live"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-lg shadow-lg">
          <img 
            src="/images/sfc_band_logo.png" 
            alt="Spoilt For Choice logo"
            class="w-full h-full object-contain bg-neutral-900 p-8 hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</MinimalLayout>
