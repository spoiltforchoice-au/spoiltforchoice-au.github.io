---
import MinimalLayout from '../layouts/MinimalLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import type { ShowsData, Show } from '../types/shows';
import showsData from '../data/shows.json';

const typedShowsData = showsData as ShowsData;

// Parse DD/MM/YYYY to a Date object
const parseShowDate = (d: string): Date => {
  const [day, month, year] = d.split('/');
  return new Date(`${year}-${month}-${day}T00:00:00`);
};

// Get next upcoming show based on today's date in AET (Australia/Sydney) at build time
const todayAET = new Date(
  new Date().toLocaleDateString('en-CA', { timeZone: 'Australia/Sydney' }) + 'T00:00:00'
);

const nextShow: Show | null = typedShowsData.shows
  .filter(s => parseShowDate(s.date) >= todayAET)
  .sort((a, b) => parseShowDate(a.date).getTime() - parseShowDate(b.date).getTime())[0] ?? null;

// Format date if show exists
const formatShowDate = (dateStr: string) => {
  const date = parseShowDate(dateStr);
  return date.toLocaleDateString('en-AU', { 
    weekday: 'short', 
    day: 'numeric', 
    month: 'short',
    year: 'numeric'
  });
};
---

<MinimalLayout 
  title="Spoilt For Choice - Canberra Cover Band" 
  description="Spoilt For Choice is a Canberra-based cover band playing everything from 80s and 90s rock to blues and modern hits. High-energy performances and crowd favourites."
>
  <div class="min-h-screen flex flex-col items-center justify-center px-4 py-12">
    <!-- Band Name Title -->
    <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold text-center mb-8 text-neutral-900">
      Spoilt For Choice
    </h1>

    <!-- Social Media Links -->
    <div class="mb-12">
      <SocialLinks />
    </div>

    <!-- Navigation Links -->
    <nav aria-label="Main navigation" class="mb-16 w-full max-w-3xl">
      <ul class="flex flex-col md:flex-row gap-4 items-stretch justify-center">
        <li class="w-full md:w-auto">
          <a 
            href="/upcoming-performance" 
            class="btn-primary text-lg px-8 py-4 block text-center w-full whitespace-nowrap"
          >
            Upcoming Performance
          </a>
        </li>
        <li class="w-full md:w-auto">
          <a 
            href="/about-us" 
            class="btn-primary text-lg px-8 py-4 block text-center w-full whitespace-nowrap"
          >
            About Us
          </a>
        </li>
        <li class="w-full md:w-auto">
          <a 
            href="/contact-us" 
            class="btn-primary text-lg px-8 py-4 block text-center w-full whitespace-nowrap"
          >
            Contact Us
          </a>
        </li>
      </ul>
    </nav>

    <!-- Next Show Announcement -->
    {nextShow && (
      <div class="w-full max-w-4xl mb-16">
        <a 
          href="/upcoming-performance"
          class="block bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow p-6 border-l-4 border-accent group"
        >
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-center md:text-left">
            <div class="flex-1">
              <span class="text-sm font-semibold text-accent uppercase tracking-wide">Next Show</span>
              <div class="mt-1 text-lg md:text-xl text-neutral-900">
                <span class="font-bold">{formatShowDate(nextShow.date)}</span>
                <span class="mx-2 text-neutral-400">•</span>
                <span class="font-semibold">{nextShow.venue}</span>
                <span class="mx-2 text-neutral-400">•</span>
                <span>{nextShow.city}{nextShow.state && `, ${nextShow.state}`}</span>
              </div>
            </div>
            {'ticketLink' in nextShow && nextShow.ticketLink && (
              <div class="md:flex-shrink-0">
                <span class="inline-block btn-primary text-sm px-6 py-2 group-hover:bg-accent-dark transition-colors">
                  Get Tickets
                </span>
              </div>
            )}
          </div>
        </a>
      </div>
    )}

    <!-- Band Photos -->
    <div class="max-w-6xl w-full">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Photo 1 -->
        <button 
          class="aspect-square overflow-hidden rounded-lg shadow-lg cursor-pointer lightbox-trigger hidden md:block"
          data-image="/images/band-photo-1.jpg"
          data-alt="Spoilt For Choice performing live"
          aria-label="View larger image of Spoilt For Choice performing"
        >
          <img 
            src="/images/band-photo-1.jpg" 
            alt="Spoilt For Choice performing live"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </button>
        <div class="aspect-square overflow-hidden rounded-lg shadow-lg md:hidden">
          <img 
            src="/images/band-photo-1.jpg" 
            alt="Spoilt For Choice performing live"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>

        <!-- Photo 2 -->
        <button 
          class="aspect-square overflow-hidden rounded-lg shadow-lg cursor-pointer lightbox-trigger hidden md:block"
          data-image="/images/band-photo-2.jpg"
          data-alt="Spoilt For Choice band photo"
          aria-label="View larger image of Spoilt For Choice"
        >
          <img 
            src="/images/band-photo-2.jpg" 
            alt="Spoilt For Choice band photo"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </button>
        <div class="aspect-square overflow-hidden rounded-lg shadow-lg md:hidden">
          <img 
            src="/images/band-photo-2.jpg" 
            alt="Spoilt For Choice band photo"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>

        <!-- Photo 3 -->
        <button 
          class="aspect-square overflow-hidden rounded-lg shadow-lg cursor-pointer lightbox-trigger hidden md:block"
          data-image="/images/band-photo-3.jpg"
          data-alt="Spoilt For Choice on stage"
          aria-label="View larger image of Spoilt For Choice on stage"
        >
          <img 
            src="/images/band-photo-3.jpg" 
            alt="Spoilt For Choice on stage"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </button>
        <div class="aspect-square overflow-hidden rounded-lg shadow-lg md:hidden">
          <img 
            src="/images/band-photo-3.jpg" 
            alt="Spoilt For Choice on stage"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>

        <!-- Photo 4 -->
        <button 
          class="aspect-square overflow-hidden rounded-lg shadow-lg cursor-pointer lightbox-trigger hidden md:block"
          data-image="/images/band-photo-4.jpg"
          data-alt="Spoilt For Choice live performance"
          aria-label="View larger image of Spoilt For Choice live"
        >
          <img 
            src="/images/band-photo-4.jpg" 
            alt="Spoilt For Choice live performance"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </button>
        <div class="aspect-square overflow-hidden rounded-lg shadow-lg md:hidden">
          <img 
            src="/images/band-photo-4.jpg" 
            alt="Spoilt For Choice live performance"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox Overlay (Desktop Only) -->
  <div id="lightbox" class="lightbox-overlay" aria-hidden="true">
    <span class="lightbox-close" aria-label="Close lightbox">&times;</span>
    <img id="lightbox-img" src="" alt="" class="lightbox-image" />
  </div>

  <script>
    // Lightbox functionality - desktop only
    if (window.innerWidth >= 768) {
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const lightboxClose = document.querySelector('.lightbox-close');
      const triggers = document.querySelectorAll('.lightbox-trigger');

      triggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
          const imageSrc = trigger.getAttribute('data-image');
          const imageAlt = trigger.getAttribute('data-alt');
          
          if (lightboxImg && lightbox && imageSrc) {
            lightboxImg.src = imageSrc;
            lightboxImg.alt = imageAlt || '';
            lightbox.classList.add('active');
            lightbox.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          }
        });
      });

      // Close lightbox function
      const closeLightbox = () => {
        if (lightbox) {
          lightbox.classList.remove('active');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      };

      // Close lightbox on overlay click
      if (lightbox) {
        lightbox.addEventListener('click', (e) => {
          // Only close if clicking the overlay itself, not the image
          if (e.target === lightbox) {
            closeLightbox();
          }
        });
      }

      // Close lightbox on close button click
      if (lightboxClose) {
        lightboxClose.addEventListener('click', (e) => {
          e.stopPropagation();
          closeLightbox();
        });
      }

      // Close lightbox on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox?.classList.contains('active')) {
          closeLightbox();
        }
      });
    }
  </script>
</MinimalLayout>
