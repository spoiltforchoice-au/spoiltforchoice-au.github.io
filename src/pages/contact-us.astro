---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<Layout 
  title="Contact Us - Spoilt For Choice" 
  description="Get in touch with Spoilt For Choice, Canberra's premier cover band, for booking enquiries and event bookings. We'd love to hear from you."
>
  <Header slot="header" />
  
  <!-- Page Header -->
  <section class="section-padding bg-neutral-900 text-white">
    <div class="container-custom text-center">
      <h1 class="mb-4">Get In Touch</h1>
      <p class="text-xl max-w-2xl mx-auto">
        Have a question or want to book us for your venue? We'd love to hear from you.
      </p>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="section-padding">
    <div class="container-custom max-w-5xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        
        <!-- Contact Information -->
        <div>
          <h2 class="text-3xl font-bold mb-6">Contact Information</h2>
          
          <div class="space-y-6">
            <!-- Booking -->
            <div>
              <h3 class="text-xl font-bold mb-2 text-accent">Booking Enquiries</h3>
              <p class="text-neutral-700 mb-2">
                For venue bookings, festival appearances, and private events:
              </p>
              <a 
                href="mailto:booking@spoiltforchoiceband.com.au"
                class="text-lg text-accent hover:text-accent-dark transition-colors font-semibold"
              >
                booking@spoiltforchoiceband.com.au
              </a>
            </div>

            <!-- General -->
            <div>
              <h3 class="text-xl font-bold mb-2 text-accent">General Enquiries</h3>
              <p class="text-neutral-700 mb-2">
                For general questions, press requests, or other enquiries:
              </p>
              <a 
                href="mailto:info@spoiltforchoiceband.com.au"
                class="text-lg text-accent hover:text-accent-dark transition-colors font-semibold"
              >
                info@spoiltforchoiceband.com.au
              </a>
            </div>

            <!-- Social Media -->
            <div>
              <h3 class="text-xl font-bold mb-3 text-accent">Social Media</h3>
              <p class="text-neutral-700 mb-4">
                Follow us on social media for the latest updates:
              </p>
              <SocialLinks />
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <h2 class="text-3xl font-bold mb-6">Send a Message</h2>
          
          <form 
            action="https://formspree.io/f/YOUR_FORM_ID"
            method="POST"
            class="space-y-4"
          >
            <!-- Name -->
            <div>
              <label for="name" class="block text-sm font-semibold mb-2">
                Name <span class="text-accent">*</span>
              </label>
              <input 
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                placeholder="Your name"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold mb-2">
                Email <span class="text-accent">*</span>
              </label>
              <input 
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                placeholder="your.email@example.com"
              />
            </div>

            <!-- Subject -->
            <div>
              <label for="subject" class="block text-sm font-semibold mb-2">
                Subject <span class="text-accent">*</span>
              </label>
              <select
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
              >
                <option value="">Select a subject</option>
                <option value="booking">Booking Enquiry</option>
                <option value="press">Press Request</option>
                <option value="general">General Question</option>
                <option value="other">Other</option>
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-sm font-semibold mb-2">
                Message <span class="text-accent">*</span>
              </label>
              <textarea 
                id="message"
                name="message"
                required
                rows="6"
                class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent resize-none"
                placeholder="Tell us more about your enquiry..."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit"
              class="btn-primary w-full"
            >
              Send Message
            </button>

            <p class="text-sm text-neutral-600 text-center">
              We'll get back to you as soon as possible, usually within 24-48 hours.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

