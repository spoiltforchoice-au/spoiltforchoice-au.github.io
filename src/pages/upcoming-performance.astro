---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShowCard from '../components/ShowCard.astro';
import showsData from '../data/shows.json';

// Sort shows
const upcomingShows = showsData.upcoming.sort((a, b) => 
  new Date(a.date).getTime() - new Date(b.date).getTime()
);
---

<Layout 
  title="Upcoming Performance - Spoilt For Choice" 
  description="Check out Spoilt For Choice's upcoming gigs around Canberra and beyond. Come see us live at a venue near you."
>
  <Header slot="header" />
  
  <!-- Page Header -->
  <section class="section-padding bg-neutral-900 text-white">
    <div class="container-custom text-center">
      <h1 class="mb-4">Upcoming Performance</h1>
      <p class="text-xl max-w-2xl mx-auto">
        Experience the raw energy of Spoilt For Choice live. Check out our upcoming shows and grab your tickets.
      </p>
    </div>
  </section>

  <!-- Upcoming Shows -->
  {upcomingShows.length > 0 ? (
    <section class="section-padding">
      <div class="container-custom">
        <div class="space-y-4 max-w-4xl mx-auto">
          {upcomingShows.map((show) => (
            <ShowCard {...show} />
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="section-padding">
      <div class="container-custom text-center">
        <p class="text-lg text-neutral-700 mb-8">
          We're currently working on new material. Check back soon for tour dates, or follow us on social media for the latest updates.
        </p>
        <a href="/contact-us" class="btn-primary">
          Contact for Booking
        </a>
      </div>
    </section>
  )}

  <!-- Booking CTA -->
  <section class="section-padding bg-accent text-white">
    <div class="container-custom text-center">
      <h2 class="mb-4">Book Us for Your Venue</h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto">
        Interested in having Spoilt For Choice perform at your venue or event? Get in touch with our booking team.
      </p>
      <a href="/contact-us" class="btn bg-white text-accent hover:bg-neutral-100">
        Contact for Booking
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

