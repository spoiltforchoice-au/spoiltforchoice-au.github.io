---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShowCard from '../components/ShowCard.astro';
import type { ShowsData, Show } from '../types/shows';
import showsData from '../data/shows.json';

const typedShowsData = showsData as ShowsData;

// Sort shows
const upcomingShows: Show[] = typedShowsData.upcoming.sort((a, b) => 
  new Date(a.date).getTime() - new Date(b.date).getTime()
);

const pastShows: Show[] = typedShowsData.past.sort((a, b) => 
  new Date(b.date).getTime() - new Date(a.date).getTime()
).slice(0, 6); // Show last 6 past shows
---

<Layout 
  title="Upcoming Performance - Spoilt For Choice" 
  description="Check out Spoilt For Choice's upcoming gigs in Canberra. Come see us live and experience our diverse setlist from 80s rock to modern hits."
>
  <Header slot="header" />
  
  <!-- Page Header -->
  <section class="section-padding bg-neutral-900 text-white">
    <div class="container-custom text-center">
      <h1 class="mb-4">Upcoming Performance</h1>
      <p class="text-xl max-w-2xl mx-auto">
        Experience the raw energy of Spoilt For Choice live. Check out our upcoming shows and grab your tickets.
      </p>
    </div>
  </section>

  <!-- Upcoming Shows -->
  {upcomingShows.length > 0 ? (
    <section class="section-padding">
      <div class="container-custom">
        <div class="space-y-4 max-w-4xl mx-auto">
          {upcomingShows.map((show) => (
            <ShowCard {...show} />
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="section-padding">
      <div class="container-custom text-center">
        <p class="text-lg text-neutral-700 mb-8">
          No performances planned at the moment...
          <br/>Got an event that needs live music? Contact us using the button below!
        </p>
        <a href="/contact-us" class="btn-primary">
          Contact for Booking
        </a>
      </div>
    </section>
  )}

  <!-- Past Shows -->
  {pastShows.length > 0 && (
    <section class="section-padding bg-neutral-100">
      <div class="container-custom">
        <h2 class="text-3xl font-bold mb-8 text-center">Past Shows</h2>
        <div class="space-y-3 max-w-4xl mx-auto">
          {pastShows.map((show) => (
            <div class="bg-white rounded-lg shadow-sm p-4 opacity-75">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div class="flex-grow">
                  <time 
                    datetime={show.date}
                    class="text-neutral-500 font-semibold text-sm block mb-1"
                  >
                    {new Date(show.date + 'T00:00:00').toLocaleDateString('en-AU', {
                      weekday: 'short',
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    })}
                  </time>
                  <div class="text-neutral-900">
                    <span class="font-bold">{show.venue}</span>
                    <span class="mx-2 text-neutral-400">•</span>
                    <span>{show.city}{show.state && `, ${show.state}`}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Booking CTA -->
  <section class="section-padding bg-accent text-white">
    <div class="container-custom text-center">
      <h2 class="mb-4">Book Us for Your Event</h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto">
        Interested in having Spoilt For Choice perform at your event? Get in touch with us!
      </p>
      <a href="/contact-us" class="btn bg-white text-accent hover:bg-neutral-100">
        Contact for Booking
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

